{
  "rules": { "no-unused-vars": "error", "eqeqeq": "error" },
  "overrides": [
    {
      "files": ["src/agent/**", "src/shared/**", "evals/**"],
      "rules": {
        "no-restricted-imports": ["error", { "paths": [{ "name": "electron", "message": "Agent, shared and eval code must run without Electron." }] }]
      }
    }
  ]
}
